#!/bin/sh
# Marmara başlatıcı.
# "-app" ile Marmara'nın kendi application.ini'si verilir: profil klasörü
# (~/.marmara), pencere sınıfı ve uzaktan kumanda adı böylece LibreWolf'tan
# ayrılır ve iki tarayıcı yan yana çalışabilir.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/marmara-bin" -app "$HERE/browser/application.ini" "$@"
