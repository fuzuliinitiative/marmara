marmara-theme-auto =
    .label = Sistem
    .title = Sistemin aydınlık ya da karanlık görünümünü izler.
marmara-theme-light =
    .label = Aydınlık
    .title = Her zaman aydınlık temayı kullanır.
marmara-theme-dark =
    .label = Karanlık
    .title = Her zaman karanlık temayı kullanır. Destekleyen web siteleri de karanlık görünür.

marmara-themes-warning =
    .heading = Temalar Marmara’nın görünümünü bozabilir
    .message = Herhangi bir tema etkinleştirirseniz tarayıcının yapısı ve görünümü bozulabilir. Aydınlık ve karanlık arasında geçiş için sayfanın üstündeki seçeneği kullanın.

## Marmara: Hizmet Koşulları Notu (ToS;DR) — adres çubuğu

# $grade: A–E, $service: hizmetin adı (ör. YouTube)
marmara-tosdr-badge =
    .tooltiptext = Hizmet koşulları notu: { $grade } ({ $service }). Ayrıntılar için tıklayın.
    .aria-label = Hizmet koşulları notu: { $grade }
marmara-tosdr-grade-label = { $grade } notu
marmara-tosdr-grade-a = Koşullar size adil davranıyor, haklarınıza saygı gösteriyor ve verilerinizi kötüye kullanmıyor.
marmara-tosdr-grade-b = Koşullar size karşı adil, ama iyileştirilebilecek yanları var.
marmara-tosdr-grade-c = Koşullar fena değil, ama dikkat etmeniz gereken konular var.
marmara-tosdr-grade-d = Koşullar çok dengesiz ya da göz önünde bulundurmanız gereken önemli sorunlar var.
marmara-tosdr-grade-e = Koşullar çok ciddi endişeler doğuruyor.
marmara-tosdr-not-reviewed = Henüz tam olarak incelenmedi; not değişebilir.
marmara-tosdr-points-heading = Öne çıkan maddeler
marmara-tosdr-loading = Maddeler yükleniyor…
marmara-tosdr-error = Maddeler alınamadı. ToS;DR'a ulaşılamıyor.
marmara-tosdr-no-points = Henüz onaylanmış madde yok.
marmara-tosdr-details-link = ToS;DR'da ayrıntılar
marmara-tosdr-site-info = Bağlantı güvenliği ve site ayarları
marmara-tosdr-privacy = Not için ToS;DR'a yalnızca sitenin alan adı sorulur. Sonuçlar yalnızca bu oturum boyunca saklanır; gizli pencerelerde hiçbir şey sorulmaz.
marmara-tosdr-attribution = Veriler: ToS;DR, CC BY-SA

