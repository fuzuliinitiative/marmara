; Marmara uygulama bilgileri. Başlatıcı bu dosyayı "-app" ile verir;
; profil klasörü, pencere sınıfı (Wayland app_id) ve uzaktan kumanda adı
; buradan gelir ve LibreWolf'la çakışmaz.
[App]
Vendor=Marmara
Name=Marmara
RemotingName=marmara
Version=@VERSION@
BuildID=@BUILDID@
Profile=marmara
SourceRepository=https://hg.mozilla.org/releases/mozilla-release
SourceStamp=@SOURCESTAMP@
; Kimlik Firefox'unkiyle aynı kalmalı, yoksa addons.mozilla.org eklentileri uyumsuz sayar.
ID={ec8030f7-c20a-464f-9b0e-13a3a9e97384}

[Gecko]
MinVersion=@VERSION@
MaxVersion=@VERSION@

[XRE]
EnableProfileMigrator=1
